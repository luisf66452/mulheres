# Copie este arquivo para .env.local e preencha com os valores reais do seu
# projeto Supabase/Stripe/Vercel. Nunca commite .env.local nem valores reais
# neste arquivo — só placeholders.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
# Só no servidor — nunca expor ao navegador. Necessária para o cron de push
# (api/push/send-due) e para ações administrativas (exclusão de conta).
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (não alterado por esta tarefa) ---
STRIPE_SECRET_KEY=coloque-a-secret-key-aqui
STRIPE_WEBHOOK_SECRET=coloque-o-webhook-secret-aqui
STRIPE_PRICE_ID_MENSAL=coloque-o-price-id-mensal-aqui
STRIPE_PRICE_ID_ANUAL=coloque-o-price-id-anual-aqui

# --- Web Push (VAPID) ---
# Gere um par de chaves VAPID reais com `npx web-push generate-vapid-keys`
# (biblioteca `web-push`, já uma dependência do projeto) e configure os
# valores gerados diretamente nas variáveis de ambiente do Vercel — nunca
# neste arquivo nem em nenhum commit. As duas chaves (pública e privada) são
# um par: gere as duas juntas e nunca reaproveite a privada de um ambiente em
# outro.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=coloque-a-chave-publica-vapid-aqui
VAPID_PRIVATE_KEY=coloque-a-chave-privada-vapid-aqui
# E-mail de contato exigido pelo protocolo Web Push (identifica quem está
# enviando, para o provedor poder contatar em caso de abuso).
VAPID_SUBJECT=mailto:rosewomand123@gmail.com

# Secret compartilhado que autentica o cron do Vercel contra
# api/push/send-due (header "Authorization: Bearer <CRON_SECRET>"). Gere um
# valor aleatório longo (ex.: `openssl rand -hex 32`) e configure o mesmo
# valor no Vercel.
CRON_SECRET=coloque-um-segredo-aleatorio-aqui
